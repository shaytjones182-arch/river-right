e fetch helpers below. */\n\n  // ─── Client-side flow classification ───────────────────────────────────────\n  // Ported from backend `classify_flow` so the app can compute flow status\n  // fully offline (well, given a live CFS reading from USGS). Returns the\n  // same {status, label} shape the rest of the UI already expects.\n  function classifyFlow(cfs, thresholds) {\n    if (cfs === null || cfs === undefined) return {\n      status: \"unknown\",\n      label: \"No data\"\n    };\n    if (thresholds) {\n      const {\n        low_threshold: lo,\n        normal_threshold: nm,\n        high_threshold: hi,\n        very_high_threshold: vh\n      } = thresholds;\n      if (typeof lo === \"number\" && typeof nm === \"number\" && typeof hi === \"number\") {\n        if (cfs < lo) return {\n          status: \"low\",\n          label: \"Very low\"\n        };\n        if (cfs < nm) return {\n          status: \"info\",\n          label: \"Low\"\n        };\n        if (cfs < hi) return {\n          status: \"safe\",\n          label: \"Normal\"\n        };\n        if (typeof vh === \"number\") {\n          if (cfs < vh) return {\n            status: \"warning\",\n            label: \"High\"\n          };\n          return {\n            status: \"danger\",\n            label: \"Very high\"\n          };\n        }\n        return {\n          status: \"warning\",\n          label: \"High\"\n        };\n      }\n    }\n    if (cfs < 100) return {\n      status: \"low\",\n      label: \"Low\"\n    };\n    if (cfs < 1500) return {\n      status: \"safe\",\n      label: \"Runnable\"\n    };\n    if (cfs < 8000) return {\n      status: \"warning\",\n      label: \"High\"\n    };\n    return {\n      status: \"danger\",\n      label: \"Flood\"\n    };\n  }\n\n  /** Fetch live CFS + gauge height directly from USGS public IV API. No\n   *  backend dependency. Returns null if the network call fails. */\n  /** Fetch live streamflow from USGS's public Instantaneous Values (IV)