\n      },\n      \"middle-fork-salmon\": {\n        \"river\": {\n          \"id\": \"middle-fork-salmon\",\n          \"name\": \"Middle Fork Salmon \\u2014 Boundary Creek to Cache Bar\",\n          \"state\": \"ID\",\n          \"class_rating\": \"III\\u2013IV\",\n          \"type\": \"whitewater\",\n          \"osm_names\": [\"Middle Fork Salmon River\", \"Salmon River\"],\n          \"description\": \"A 98-mile permitted wilderness run from Boundary Creek down to Cache Bar, tracing the Middle Fork of the Salmon through the heart of the Frank Church-River of No Return Wilderness. Widely regarded as the finest multi-day whitewater trip in the Lower 48: five to seven days of nearly continuous Class III\\u2013IV rapids, technical low-water boulder gardens giving way to pushy big-water waves as the river builds, with over 300 named drops between the put-in and the confluence. Between rapids you'll find natural hot springs on the bank, side-canyon hikes to painted-rock pictographs, and camping under some of the darkest skies in the country \\u2014 no roads, no cell service, and no bailout points once you launch.\",\n          \"hazards\": [\"Permit required \\u2014 Four Rivers Lottery (recreation.gov)\", \"Remote wilderness, no cell service, no road access between put-in and take-out\", \"Continuous Class III\\u2013IV at standard flows; rated higher at high water\"],\n          \"points_of_interest\": [\"Velvet Falls (II\\u2013IV): first major drop, ~5 mi in\", \"Pistol Creek (III\\u2013IV): tight S-turn between cliff walls\", \"Tappan Falls (III\\u2013IV): boulder-garden mid-river drop\", \"Redside Rapids (III\\u2013IV): big-water finale\", \"Loon Creek Hot Spring + Sunflower Hot Springs along the run\"],\n          \"put_in\": {\n            \"name\": \"Boundary Creek Put-in\",\n            \"lat\": 44.531894,\n            \"lon\": -115.294245\n          },\n          \"take_out\": {\n            \"name\": \"Cache Bar Boat Ramp\",\n            \"lat\": 45.31856,\n 